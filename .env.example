# Auth
NEXT_PUBLIC_APP_URL=https://www.neerzy.com
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Google Cloud (GMB & OAuth)
GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_MAPS_API_KEY=your_geocoding_api_key_here
GOOGLE_PLACES_API_KEY=your_places_api_key_here
GOOGLE_MY_BUSINESS_ACCOUNT_MANAGEMENT_API_KEY=your_account_management_api_key_here
GOOGLE_MY_BUSINESS_INFORMATION_API_KEY=your_business_information_api_key_here

# Meta WhatsApp Cloud API (replaces Twilio)
META_WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id_here
META_WHATSAPP_BUSINESS_ID=your_meta_whatsapp_business_id_here
META_WHATSAPP_VERIFY_TOKEN=your_meta_webhook_verify_token_here

# Template names (configured in Meta Business Manager)
META_TEMPLATE_REVIEW_REQUEST=review_request
META_TEMPLATE_POST_READY=post_ready

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Paddle (Subscription Management)
NEXT_PUBLIC_PADDLE_VENDOR_ID=your_vendor_id_here
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_client_token_here
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_webhook_secret_here

# Neerzy Internal (AI & Automation)
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat



NEERZY_API_KEY=nz_your_internal_api_key_here
NEERZY_INTERNAL_URL=https://api.neerzy.com

# Webhook
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here

# Admin Portal (private /admin dashboard)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_strong_password
ADMIN_JWT_SECRET=generate_a_long_random_string

# Review pipeline (/gmb-audit-tool reviews)
# Salt for hashing reviewer IPs before storage. Any long random string —
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it resets the one-rating-per-scan dedupe (existing hashes stop matching).
REVIEW_IP_SALT=generate_a_long_random_string

# -----------------------------------------------------------
# Onboarding emails & lead automation
# -----------------------------------------------------------
# Resend (guaranteed email channel). Verify neerzy.com in Resend before prod sends.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Neerzy <support@neerzy.com>"
EMAIL_REPLY_TO=support@neerzy.com

# Anthropic Claude (lead reply drafts). Model is env-configurable.
ANTHROPIC_API_KEY=sk-ant-your_key_here
CLAUDE_MODEL=claude-haiku-5-5

# Meta templates for the best-effort WhatsApp channel
META_TEMPLATE_LEAD_ACK=lead_ack
META_TEMPLATE_ADMIN_LEAD_NOTIFY=admin_lead_notify

# Cron / internal route auth (also guards /api/debug/email-test)
CRON_SECRET=generate_a_long_random_string

# Set to 1 to log emails/messages instead of sending (staging & local tests)
AUTOMATION_DRY_RUN=0

